# PostgreSQL Database Connection URL
# Local PostgreSQL, Supabase, Neon, or Docker PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/exam_proctoring?schema=public"

# JWT Secret for signing authentication tokens (Must be at least 32 characters)
JWT_SECRET="exam_proctoring_super_secure_jwt_secret_key_32bytes_long"

# Default Single Admin credentials (Used for seeding)
ADMIN_EMAIL="admin@proctor.com"
ADMIN_PASSWORD="AdminSecurePass123!"
ADMIN_NAME="Super Administrator"

# Gemini API key used to extract mixed question types and answer keys from PDFs.
# Create a key in Google AI Studio, then add it to your local .env file.
GEMINI_API_KEY=""
